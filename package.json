{
  "homepage": "https://sarahnessa.github.io/done-landing-page",
  "name": "done-landing-page",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "oxlint"
    ],
    "*.{json,css,md,html}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build && cp dist/index.html dist/404.html",
    "test": "vitest run",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "lint": "oxlint && npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "mkcert": "^3.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.65.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "browserstack-node-sdk": "^1.80.6",
    "dotenv": "^18.0.10",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.2",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.1.1",
    "vitest-axe": "^0.1.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "protobufjs@7.6.6": true
  }
}
